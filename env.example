# Supabase project (Settings -> API in the Supabase dashboard)
SUPABASE_URL=https://your-project.supabase.co
# Service role key — server-only, never expose this to the browser.
# It bypasses row-level security, which is intentional here: only the
# API routes in src/app/api/** use it, and completions has no RLS
# policies, so nothing else can read/write the table.
SUPABASE_SERVICE_ROLE_KEY=

# Base64-encoded bcrypt hash of the shared facilitator password. Base64,
# not the raw hash: a raw bcrypt hash is full of literal "$" characters,
# and Next's .env loader (like some hosting dashboards) treats "$NAME" as
# variable expansion and silently mangles it. Generate this value with:
#   node -e "require('bcryptjs').hash(process.argv[1],10).then(h=>console.log(Buffer.from(h).toString('base64')))" "your-password-here"
FACILITATOR_PASSWORD_HASH_B64=

# Random secret used to sign the facilitator session cookie. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=

# Resend (resend.com) — used to email assignment/reminder notifications.
# Free tier is fine to start. Get the key from Resend's dashboard.
RESEND_API_KEY=
# Optional: "Name <you@yourdomain.com>". Defaults to Resend's shared
# onboarding@resend.dev sender, which works without verifying a domain but
# is best replaced with your own verified domain for real deliverability.
RESEND_FROM_EMAIL=

# Full URL of the deployed app (no trailing slash), used as the link in
# assignment/reminder emails, e.g. https://de-escalation-training.vercel.app
APP_URL=

# Shared secret Vercel Cron sends as "Authorization: Bearer <value>" when it
# triggers /api/cron/send-reminders — set this in Vercel and it's wired in
# automatically for you, no code changes needed. Generate with:
#   openssl rand -base64 32
CRON_SECRET=
